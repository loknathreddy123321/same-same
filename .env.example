# ── Required ──────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1

# ── LLM — priority: Azure OpenAI > Bedrock > Groq (see src/agent/bedrock.py) ──
# Azure OpenAI — needs a deployed model in an Azure OpenAI resource.
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-10-21

# AWS Bedrock — requires model access granted in the Bedrock console for
# this account/region, and the caller needs bedrock:InvokeModel. Claude
# models are only available in specific regions — check availability
# before picking AWS_REGION above.
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Groq — free, used only if neither of the above is set.
# GROQ_API_KEY=gsk_your_groq_key_here

# ── Optional (agent will skip snapshots if not set) ───────────────────────────
S3_SNAPSHOT_BUCKET=cfn-drift-snapshots-632127306362-dev
DYNAMODB_AUDIT_TABLE=cfn-drift-audit

# ── Slack (optional — agent auto-approves locally if not set) ─────────────────
# SLACK_BOT_TOKEN=xoxb-your-token
# SLACK_CHANNEL_ID=C1234567890

# ── Dashboard login (basic shared-credential gate, not per-user SSO) ──────────
# Defaults to admin/admin if unset — CHANGE before exposing beyond localhost.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me
# Signs session cookies — set a long random value in any shared/deployed environment.
DASHBOARD_SECRET=change-me-too
